          "type": "button",
          "id": "live",
          "placement": {
            "width": "match",
            "height": "44dp",
            "flexGrow": 1,
            "mode": "flow"
          },
          "styleRefs": [
            "app.buttonSecondary"
          ],
          "style": {
            "padding": "6dp",
            "borderWidth": "0dp",
            "radius": "16dp"
          },
          "commonProps": {
            "scrollable": false
          },
          "layout": {
            "type": "flex",
            "mainAlign": "center",
            "crossAlign": "center"
          },
          "events": [
            {
              "type": "clicked",
              "action": "logs.live"
            }
          ],
          "children": [
            {
              "type": "label",
              "id": "title",
