{
  "api": 1,
  "units": "dp",
  "root": {
    "type": "container",
    "id": "root",
    "width": "fill",
    "height": "fill",
    "layout": "column",
    "padding": 8,
    "gap": 6,
    "style": {
      "backgroundColor": "$background"
    },
    "children": [
      {
        "type": "container",
        "id": "header",
        "width": "fill",
        "height": 36,
        "layout": "row",
        "gap": 6,
        "children": [
          {
            "type": "label",
            "id": "title",
            "text": "Ping",
            "width": "fill",
            "height": 36,
            "fontSize": 16,
            "style": {
              "textColor": "$text"
            }
          },
          {
            "type": "container",
            "id": "modeBtn",
            "width": 40,
            "height": 36,
            "layout": "row",
            "padding": 6,
            "style": {
              "backgroundColor": "$accent",
              "radius": 10
            },
            "children": [
              {
                "type": "image",
                "id": "modeIcon",
                "src": "mode",
                "width": 24,
                "height": 24
              }
            ]
          }
        ]
      },
      {
        "type": "container", "id": "wifiCard", "width": "fill", "height": "content",
        "layout": "column", "gap": 2,
        "children": [
          { "type": "label", "id": "wifiName", "text": "未连接", "width": "fill", "height": 24, "fontSize": 16 },
          { "type": "label", "id": "wifiAddress", "text": "IP: --", "width": "fill", "height": 24, "fontSize": 16 }
        ]
      },
      {
        "type": "textInput",
        "id": "address",
        "placeholder": "主机或协议地址",
        "width": "fill",
        "height": 40,
        "maxLength": 240
      },
      {
        "type": "container",
        "id": "actions",
        "width": "fill",
        "height": 40,
        "layout": "row",
        "gap": 6,
        "children": [
          {
            "type": "button",
            "id": "action",
            "text": "开始测试",
            "width": "fill",
            "height": 40,
            "fontSize": 16
          },
          {
            "type": "button",
            "id": "options",
            "text": "账号",
            "width": 64,
            "height": 40,
            "fontSize": 16,
            "style": {
              "hidden": true
            }
          }
        ]
      },
      {
        "type": "container",
        "id": "topicRow",
        "width": "fill",
        "height": 40,
        "layout": "row",
        "gap": 6,
        "children": [
          {
            "type": "textInput",
            "id": "topic",
            "placeholder": "MQTT 主题",
            "width": "fill",
            "height": 40,
            "maxLength": 128
          },
          {
            "type": "button",
            "id": "subscribe",
            "text": "订阅",
            "width": 64,
            "height": 40,
            "fontSize": 16
          }
        ],
        "style": {
          "hidden": true
        }
      },
      {
        "type": "container",
        "id": "messageRow",
        "width": "fill",
        "height": 40,
        "layout": "row",
        "gap": 6,
        "children": [
          {
            "type": "textInput",
            "id": "message",
            "placeholder": "消息",
            "width": "fill",
            "height": 40,
            "maxLength": 160
          },
          {
            "type": "button",
            "id": "send",
            "text": "发送",
            "width": 64,
            "height": 40,
            "fontSize": 16
          }
        ],
        "style": {
          "hidden": true
        }
      },
      {
        "type": "label",
        "id": "status",
        "text": "未开始",
        "width": "fill",
        "height": 28,
        "fontSize": 16,
        "style": {
          "textColor": "$text"
        }
      },
      {
        "type": "container",
        "id": "results",
        "scroll": true,
        "width": "fill",
        "height": "fill",
        "layout": "column",
        "gap": 4,
        "padding": 8,
        "style": {
          "backgroundColor": "$surface",
          "radius": 12
        },
        "children": [
          {
            "type": "label",
            "id": "log0",
            "text": "",
            "width": "fill",
            "height": "content",
            "fontSize": 14,
            "style": {
              "textColor": "$text"
            }
          },
          {
            "type": "label",
            "id": "log1",
            "text": "",
            "width": "fill",
            "height": "content",
            "fontSize": 14,
            "style": {
              "textColor": "$text"
            }
          },
          {
            "type": "label",
            "id": "log2",
            "text": "",
            "width": "fill",
            "height": "content",
            "fontSize": 14,
            "style": {
              "textColor": "$text"
            }
          },
          {
            "type": "label",
            "id": "log3",
            "text": "",
            "width": "fill",
            "height": "content",
            "fontSize": 14,
            "style": {
              "textColor": "$text"
            }
          }
        ]
      },
      {
        "type": "bottomSheet",
        "id": "modes",
        "text": "选择模式",
        "width": "fill",
        "height": "content",
        "padding": 12,
        "gap": 8,
        "children": [
          {
            "type": "button",
            "id": "mode0",
            "text": "Ping",
            "width": "fill",
            "height": 40,
            "fontSize": 16
          },
          {
            "type": "button",
            "id": "mode1",
            "text": "HTTP / HTTPS",
            "width": "fill",
            "height": 40,
            "fontSize": 16
          },
          {
            "type": "button",
            "id": "mode2",
            "text": "WebSocket",
            "width": "fill",
            "height": 40,
            "fontSize": 16
          },
          {
            "type": "button",
            "id": "mode3",
            "text": "MQTT",
            "width": "fill",
            "height": 40,
            "fontSize": 16
          },
          {
            "type": "button", "id": "networkInfo", "text": "网络信息",
            "width": "fill", "height": 40, "fontSize": 16
          }
        ]
      },
      {
        "type": "bottomSheet",
        "id": "infoSheet",
        "text": "网络信息", "width": "fill", "height": "content", "padding": 12, "gap": 8,
        "children": [
          { "type": "label", "id": "infoState", "text": "", "width": "fill", "height": "content", "fontSize": 16 },
          { "type": "label", "id": "infoName", "text": "", "width": "fill", "height": "content", "fontSize": 16 },
          { "type": "label", "id": "infoAddress", "text": "", "width": "fill", "height": "content", "fontSize": 16 },
          { "type": "label", "id": "infoSignal", "text": "", "width": "fill", "height": "content", "fontSize": 16 },
          { "type": "label", "id": "infoTime", "text": "", "width": "fill", "height": "content", "fontSize": 16 },
          { "type": "button", "id": "infoDone", "text": "完成", "width": "fill", "height": 40, "fontSize": 16 }
        ]
      },
      {
        "type": "bottomSheet",
        "id": "credentials",
        "text": "MQTT 账号",
        "width": "fill",
        "height": "content",
        "padding": 12,
        "gap": 8,
        "children": [
          {
            "type": "textInput",
            "id": "username",
            "placeholder": "用户名（可选）",
            "width": "fill",
            "height": 40,
            "maxLength": 63
          },
          {
            "type": "textInput",
            "id": "password",
            "placeholder": "密码（可选）",
            "width": "fill",
            "height": 40,
            "maxLength": 63,
            "inputType": "password"
          },
          {
            "type": "button",
            "id": "credentialsDone",
            "text": "完成",
            "width": "fill",
            "height": 40,
            "fontSize": 16
          }
        ]
      }
    ]
  }
}
