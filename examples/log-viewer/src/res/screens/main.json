{
  "type": "viewScreen",
  "id": "main",
  "styleRefs": [
    "app.page"
  ],
  "style": {
    "padding": "12dp",
    "paddingTop": "30dp",
    "paddingBottom": "28dp",
    "borderWidth": "0dp"
  },
  "placement": {
    "width": "${env.widthDp}",
    "height": "${env.heightDp}",
    "mode": "flow"
  },
  "commonProps": {
    "scrollable": true
  },
  "layout": {
    "type": "flex",
    "flexFlow": "column",
    "gap": "8dp",
    "crossAlign": "center"
  },
  "children": [
    {
      "type": "label",
      "id": "title",
      "placement": {
        "width": "100%",
        "height": "wrap",
        "mode": "flow"
      },
      "styleRefs": [
        "app.body"
      ],
      "style": {
        "fontSize": "22sp"
      },
      "commonProps": {
        "clickable": false
      },
      "labelProps": {
        "text": "${constant.ui.title}"
      },
      "bindings": {
        "labelProps.text": "text"
      }
    },
    {
      "type": "container",
      "id": "modes",
      "placement": {
        "width": "100%",
