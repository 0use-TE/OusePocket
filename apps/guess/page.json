{
  "api": 1,
  "units": "dp",
  "root": {
    "type": "container",
    "id": "page",
    "width": "fill",
    "height": "fill",
    "layout": "column",
    "padding": 12,
    "gap": 12,
    "style": { "backgroundColor": "$background" },
    "children": [
      {
        "type": "container",
        "id": "heading",
        "width": "fill",
        "height": 40,
        "layout": "row",
        "gap": 8,
        "children": [
          { "type": "label", "id": "title", "text": "猜数字", "width": "fill", "height": 40, "fontSize": 22, "style": { "textColor": "$text" } },
          { "type": "button", "id": "again", "text": "再来", "width": 72, "height": 40 }
        ]
      },
      {
        "type": "container",
        "id": "stage",
        "width": "fill",
        "height": "fill",
        "layout": "column",
        "gap": 12,
        "padding": 16,
        "style": { "backgroundColor": "$surface", "radius": 18, "borderColor": "$border", "borderWidth": 1 },
        "children": [
          { "type": "label", "id": "range", "text": "1 - 100", "width": "fill", "height": 36, "fontSize": 20, "style": { "textAlign": "center", "textColor": "$text" } },
          { "type": "label", "id": "hint", "text": "猜一个数", "width": "fill", "height": 48, "fontSize": 24, "style": { "textAlign": "center", "textColor": "$accent" } },
          { "type": "label", "id": "tries", "text": "已猜 0 次", "width": "fill", "height": 32, "fontSize": 18, "style": { "textAlign": "center", "textColor": "$secondary" } },
          { "type": "container", "id": "spacer", "width": "fill", "height": "fill" },
          { "type": "textInput", "id": "input", "placeholder": "输入数字", "width": "fill", "height": 48, "maxLength": 3, "inputType": "number", "keyboardMode": "pan" },
          { "type": "button", "id": "guess", "text": "猜", "width": "fill", "height": 56, "fontSize": 20, "style": { "backgroundColor": "$accent", "textColor": "#ffffff", "radius": 16 } }
        ]
      }
    ]
  }
}
