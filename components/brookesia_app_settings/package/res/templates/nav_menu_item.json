{
  "type": "viewTemplate",
  "id": "nav_menu_item",
  "node": {
    "type": "button",
    "interactionRefs": [
      "press.item"
    ],
    "events": [],
    "styleRefs": [
      "app.listItem"
    ],
    "style": {
      "borderWidth": "0dp",
      "padding": "6dp"
    },
    "layout": {
      "type": "grid",
      "gridTemplateColumns": [
        "32dp",
        "match",
        "18dp"
      ],
      "gridTemplateRows": [
        "24dp",
        "18dp"
      ],
      "gap": "2dp",
      "crossAlign": "center"
    },
    "placement": {
      "mode": "flow",
      "width": "match",
      "height": "${constant.settings.layout.rowHeight}",
      "alignSelf": "stretch"
    },
    "children": [
      {
        "type": "image",
        "id": "icon",
        "styleRefs": [
          "app.iconRecolor"
        ],
        "commonProps": {
          "clickable": false
        },
        "imageProps": {
          "innerAlign": "contain"
        },
        "placement": {
          "mode": "flow",
          "gridColumn": 0,
          "gridRow": 0,
          "gridRowSpan": 2,
          "width": "28dp",
          "height": "28dp",
          "alignSelf": "center"
        },
        "style": {
          "bgOpacity": 0,
          "borderWidth": "0dp"
        }
      },
      {
        "type": "container",
        "id": "title_box",
        "commonProps": {
          "clickable": false
        },
        "layout": {
          "type": "flex",
          "flexFlow": "row",
          "mainAlign": "start",
          "crossAlign": "center"
        },
        "placement": {
          "mode": "flow",
          "gridColumn": 1,
          "gridRow": 0,
          "alignSelf": "stretch",
          "height": "match"
        },
        "children": [
          {
            "type": "label",
            "id": "title",
            "styleRefs": [
              "app.listItemTitle"
            ],
            "labelProps": {
              "text": "Item"
            },
            "style": {
              "fontSize": "16sp"
            },
            "placement": {
              "mode": "flow",
              "width": "match"
            },
            "bindings": {
              "labelProps.text": "labelProps.text"
            }
          }
        ],
        "style": {
          "padding": "0dp",
          "bgColor": "",
          "borderWidth": "0dp"
        }
      },
      {
        "type": "container",
        "id": "value_box",
        "commonProps": {
          "clickable": false
        },
        "layout": {
          "type": "flex",
          "flexFlow": "row",
          "mainAlign": "start",
          "crossAlign": "center"
        },
        "placement": {
          "mode": "flow",
          "gridColumn": 1,
          "gridRow": 1,
          "alignSelf": "stretch",
          "height": "match"
        },
        "children": [
          {
            "type": "label",
            "id": "value",
            "styleRefs": [
              "app.listItemValue"
            ],
            "labelProps": {
              "text": ""
            },
            "style": {
              "fontSize": "12sp"
            },
            "placement": {
              "mode": "flow",
              "width": "match"
            },
            "bindings": {
              "labelProps.text": "labelProps.text"
            }
          }
        ],
        "style": {
          "padding": "0dp",
          "bgColor": "",
          "borderWidth": "0dp"
        }
      },
      {
        "type": "label",
        "id": "chevron",
        "styleRefs": [
          "app.listItemValue"
        ],
        "labelProps": {
          "text": ">"
        },
        "placement": {
          "mode": "flow",
          "gridColumn": 2,
          "gridRow": 0,
          "gridRowSpan": 2,
          "alignSelf": "center"
        },
        "bindings": {
          "labelProps.text": "labelProps.text"
        }
      }
    ]
  }
}
