      {"type": "label", "id": "alarms", "text": "", "width": "fill", "height": "content", "fontSize": 14},
      {"type": "label", "id": "result", "text": "不申请后台 JS；可回桌面或关闭后检查原生闹钟", "width": "fill", "height": "content", "fontSize": 14}
