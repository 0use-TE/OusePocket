# Product-only source overlay. Keep the downloaded reference component intact.
# Replace exactly one known upstream idle sleep and fail loudly if it changes.
idf_component_get_property(pocket_utils_lib brookesia_lib_utils COMPONENT_LIB)
get_target_property(pocket_utils_sources ${pocket_utils_lib} SOURCES)
set(pocket_utils_patched_sources "")
set(pocket_scheduler_replacement_count 0)
foreach(pocket_source IN LISTS pocket_utils_sources)
    get_filename_component(pocket_source_name "${pocket_source}" NAME)
    if(pocket_source_name STREQUAL "task_scheduler.cpp")
        if(NOT IS_ABSOLUTE "${pocket_source}")
            idf_component_get_property(pocket_utils_dir brookesia_lib_utils COMPONENT_DIR)
            set(pocket_source "${pocket_utils_dir}/${pocket_source}")
        endif()
        set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${pocket_source}")
        file(READ "${pocket_source}" pocket_scheduler_text)
        set(pocket_sleep_original "boost::this_thread::sleep_for(boost::chrono::milliseconds(poll_interval_ms));")
        string(FIND "${pocket_scheduler_text}" "${pocket_sleep_original}" pocket_sleep_position)
        if(pocket_sleep_position EQUAL -1)
            message(FATAL_ERROR "Brookesia scheduler idle wait changed; review the OusePocket source overlay")
        endif()
        string(REPLACE "${pocket_sleep_original}" "" pocket_scheduler_without_sleep "${pocket_scheduler_text}")
        string(LENGTH "${pocket_scheduler_text}" pocket_before_length)
        string(LENGTH "${pocket_scheduler_without_sleep}" pocket_after_length)
        string(LENGTH "${pocket_sleep_original}" pocket_sleep_length)
        math(EXPR pocket_removed_length "${pocket_before_length} - ${pocket_after_length}")
        if(NOT pocket_removed_length EQUAL pocket_sleep_length)
            message(FATAL_ERROR "Expected exactly one Brookesia scheduler idle wait")
        endif()
        string(REPLACE "${pocket_sleep_original}" "::ouse::scheduler_poll_wait(poll_interval_ms);"
            pocket_scheduler_text "${pocket_scheduler_text}")
        set(pocket_scheduler_generated "${CMAKE_CURRENT_BINARY_DIR}/pocket_task_scheduler.cpp")
        file(CONFIGURE OUTPUT "${pocket_scheduler_generated}" CONTENT
            "#include \"pocket_scheduler_wait.hpp\"\n${pocket_scheduler_text}" @ONLY)
        get_source_file_property(pocket_scheduler_flags "${pocket_source}" COMPILE_FLAGS)
        if(pocket_scheduler_flags)
            set_source_files_properties("${pocket_scheduler_generated}" PROPERTIES COMPILE_FLAGS "${pocket_scheduler_flags}")
        endif()
        list(APPEND pocket_utils_patched_sources "${pocket_scheduler_generated}")
        math(EXPR pocket_scheduler_replacement_count "${pocket_scheduler_replacement_count} + 1")
    else()
        list(APPEND pocket_utils_patched_sources "${pocket_source}")
    endif()
endforeach()
if(NOT pocket_scheduler_replacement_count EQUAL 1)
    message(FATAL_ERROR "Could not identify exactly one Brookesia task_scheduler.cpp")
endif()
set_property(TARGET ${pocket_utils_lib} PROPERTY SOURCES "${pocket_utils_patched_sources}")
target_include_directories(${pocket_utils_lib} PRIVATE "${CMAKE_CURRENT_LIST_DIR}/../include")
message(STATUS "OusePocket: scheduler idle polling uses FreeRTOS delay")
