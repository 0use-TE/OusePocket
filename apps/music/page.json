{
  "api": 1,
  "units": "dp",
  "initialPage": "player",
  "pages": [
    {
      "id": "player",
      "root": {
        "type": "container",
        "id": "root",
        "width": "fill",
        "height": "fill",
        "padding": 12,
        "style": { "backgroundColor": "$background" },
        "children": [
          { "type": "label", "id": "title", "text": "音乐", "x": 0, "y": 0, "width": 100, "height": 28, "fontSize": 22, "style": { "textColor": "$text", "textAlign": "left" } },
          { "type": "button", "id": "library", "text": "曲库", "width": 64, "height": 30, "fontSize": 14, "x": 232, "y": 0 },
          { "type": "image", "id": "record", "src": "cover", "x": 84, "y": 38, "width": 128, "height": 128 },
          { "type": "label", "id": "track", "text": "正在读取曲库", "x": 0, "y": 178, "width": "fill", "height": 28, "fontSize": 20, "style": { "textColor": "$text", "textAlign": "center" } },
          { "type": "label", "id": "state", "text": "准备就绪", "x": 0, "y": 210, "width": "fill", "height": 20, "fontSize": 13, "style": { "textColor": "$secondary", "textAlign": "center" } },
          { "type": "progressBar", "id": "progress", "x": 8, "y": 238, "width": 280, "height": 5, "min": 0, "max": 100, "value": 0 },
          { "type": "label", "id": "time", "text": "0:00 / 0:00", "x": 0, "y": 248, "width": "fill", "height": 18, "fontSize": 12, "style": { "textColor": "$secondary", "textAlign": "center" } },
          {
            "type": "container", "id": "transport", "x": 44, "y": 278, "width": 208, "height": 56, "layout": "row", "gap": 20,
            "children": [
              { "type": "button", "id": "previous", "text": "<<", "width": 56, "height": 56, "fontSize": 14, "style": { "radius": 28, "backgroundColor": "$surface", "textColor": "$text" } },
              { "type": "button", "id": "play", "text": "播放", "width": 56, "height": 56, "fontSize": 14, "style": { "radius": 28, "backgroundColor": "$accent", "textColor": "#ffffff" } },
              { "type": "button", "id": "next", "text": ">>", "width": 56, "height": 56, "fontSize": 14, "style": { "radius": 28, "backgroundColor": "$surface", "textColor": "$text" } }
            ]
          },
          {
            "type": "container", "id": "actions", "x": 0, "y": 344, "width": "fill", "height": 30, "layout": "row", "gap": 8,
            "children": [
              { "type": "button", "id": "pause", "text": "暂停", "width": 84, "height": 30, "fontSize": 14 },
              { "type": "button", "id": "stop", "text": "停止", "width": 84, "height": 30, "fontSize": 14 },
              { "type": "button", "id": "mode", "text": "单曲播放", "width": 112, "height": 30, "fontSize": 14 }
            ]
          }
        ]
      }
    },
    {
