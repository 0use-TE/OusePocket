                "text": "网络请求",
                "width": "fill",
                "height": 44
              },
              {
                "type": "button",
                "id": "go_media",
                "text": "媒体服务",
                "width": "fill",
                "height": 44
              },
              {
                "type": "button",
                "id": "go_alarms",
                "text": "闹钟服务",
                "width": "fill",
                "height": 44
              },
              {
                "type": "button",
                "id": "go_usb",
                "text": "USB 状态",
                "width": "fill",
                "height": 44
              }
            ]
          },
          {
            "type": "label",
            "id": "result",
            "text": "",
            "width": "fill",
            "height": "content",
            "fontSize": 14
          }
        ]
      }
    },
