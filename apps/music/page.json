{
  "api": 1,
  "units": "dp",
  "initialPage": "player",
  "pages": [
    {
      "id": "player",
      "root": {
        "type": "container",
        "id": "root",
        "width": "fill",
        "height": "fill",
        "layout": "column",
        "scroll": true,
        "padding": 12,
        "gap": 10,
        "children": [
          {
            "type": "toolbar",
            "id": "title",
            "text": "音乐",
            "width": "fill",
            "height": 44
          },
          {
            "type": "label",
            "id": "track",
            "text": "致爱丽丝 · 30 秒",
            "width": "fill",
            "height": "content",
            "fontSize": 24
          },
          {
            "type": "label",
            "id": "state",
            "text": "尚未播放",
            "width": "fill",
            "height": "content",
            "fontSize": 16
          },
          {
            "type": "progressBar",
            "id": "progress",
            "width": "fill",
            "height": 8,
            "min": 0,
            "max": 100,
            "value": 0
          },
          {
            "type": "label",
            "id": "time",
            "text": "0:00 / 0:00",
            "width": "fill",
            "height": "content",
            "fontSize": 16
          },
          {
            "type": "container",
            "id": "transport",
            "width": "fill",
            "height": "content",
            "layout": "row",
            "gap": 8,
            "children": [
              {
                "type": "button",
                "id": "previous",
                "text": "上一首",
                "width": "fill",
                "height": 44
              },
              {
                "type": "button",
                "id": "play",
                "text": "播放",
                "width": "fill",
                "height": 44
              },
              {
                "type": "button",
                "id": "next",
                "text": "下一首",
                "width": "fill",
                "height": 44
              }
            ]
          },
          {
            "type": "container",
            "id": "actions",
            "width": "fill",
            "height": "content",
            "layout": "row",
            "gap": 8,
            "children": [
              {
                "type": "button",
                "id": "pause",
                "text": "暂停",
                "width": "fill",
                "height": 44
              },
              {
                "type": "button",
                "id": "stop",
                "text": "停止",
                "width": "fill",
                "height": 44
              }
            ]
          },
          {
            "type": "container",
            "id": "options",
            "width": "fill",
            "height": "content",
            "layout": "row",
            "gap": 8,
            "children": [
              {
                "type": "button",
                "id": "mode",
                "text": "单曲播放",
                "width": "fill",
                "height": 44
              },
              {
                "type": "button",
                "id": "library",
                "text": "播放列表",
                "width": "fill",
                "height": 44
              }
            ]
          }
        ]
      }
    },
    {
      "id": "library",
      "root": {
        "type": "container",
        "id": "root",
        "width": "fill",
        "height": "fill",
        "layout": "column",
        "scroll": true,
        "padding": 12,
        "gap": 10,
