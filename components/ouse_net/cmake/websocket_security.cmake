idf_component_get_property(ouse_ws_lib espressif__esp_websocket_client COMPONENT_LIB)
idf_component_get_property(ouse_ws_dir espressif__esp_websocket_client COMPONENT_DIR)
get_target_property(ouse_ws_sources "${ouse_ws_lib}" SOURCES)
set(ouse_ws_result "")
set(ouse_ws_patched 0)
foreach(ouse_source IN LISTS ouse_ws_sources)
    if(NOT IS_ABSOLUTE "${ouse_source}")
        get_filename_component(ouse_source "${ouse_source}" ABSOLUTE BASE_DIR "${ouse_ws_dir}")
    endif()
    get_filename_component(ouse_name "${ouse_source}" NAME)
    if(ouse_name STREQUAL "esp_websocket_client.c")
        file(READ "${ouse_source}" ouse_ws_text)
        string(REPLACE "\r\n" "\n" ouse_ws_text "${ouse_ws_text}")
        string(SHA256 ouse_ws_hash "${ouse_ws_text}")
        if(NOT ouse_ws_hash STREQUAL "18041ec37d3456bc1ecb3275a78c3ae64679f57f049b5b05af169ef6b1857c77")
            message(FATAL_ERROR "WebSocket source changed; review redirect rejection")
        endif()
        string(REPLACE "if (result < 0) {" "if (result < 0 || WS_HTTP_REDIRECT(result)) {" ouse_ws_text "${ouse_ws_text}")
        set(ouse_source "${CMAKE_BINARY_DIR}/ouse_security/esp_websocket_client.c")
        file(MAKE_DIRECTORY "${CMAKE_BINARY_DIR}/ouse_security")
        file(WRITE "${ouse_source}" "${ouse_ws_text}")
        set(ouse_ws_patched 1)
    endif()
    list(APPEND ouse_ws_result "${ouse_source}")
endforeach()
if(NOT ouse_ws_patched)
    message(FATAL_ERROR "WebSocket security overlay did not match")
endif()
set_property(TARGET "${ouse_ws_lib}" PROPERTY SOURCES "${ouse_ws_result}")
target_include_directories("${ouse_ws_lib}" PRIVATE "${ouse_ws_dir}")
