{
  "api": 1,
  "units": "dp",
  "root": {
    "type": "container",
    "id": "page",
    "width": "fill",
    "height": "fill",
    "layout": "column",
    "padding": 12,
    "gap": 10,
    "style": { "backgroundColor": "$background" },
    "children": [
      {
        "type": "label",
        "id": "title",
        "text": "使用说明",
        "width": "fill",
        "height": 36,
        "fontSize": 22,
        "style": { "textColor": "$text" }
      },
      {
        "type": "container",
        "id": "body",
        "width": "fill",
        "height": "fill",
        "layout": "column",
        "gap": 10,
        "padding": 14,
        "scroll": true,
        "style": {
          "backgroundColor": "$surface",
          "radius": 16,
          "borderColor": "$border",
          "borderWidth": 1
        },
        "children": [
          {
            "type": "label",
            "id": "step1",
            "text": "1. 打开「应用商店」",
            "width": "fill",
            "height": 28,
            "fontSize": 16,
            "style": { "textColor": "$text" }
          },
          {
            "type": "label",
            "id": "step2",
            "text": "2. 默认已连接商店，可直接浏览",
            "width": "fill",
            "height": 44,
            "fontSize": 16,
            "style": { "textColor": "$text" }
          },
          {
            "type": "label",
            "id": "step3",
            "text": "3. 点开应用，再点「安装」",
            "width": "fill",
            "height": 28,
            "fontSize": 16,
            "style": { "textColor": "$text" }
          },
          {
            "type": "label",
            "id": "step4",
            "text": "4. 系统提示里确认，等待完成",
            "width": "fill",
            "height": 44,
            "fontSize": 16,
            "style": { "textColor": "$text" }
          },
          {
            "type": "label",
            "id": "step5",
            "text": "5. 回到桌面打开新应用",
            "width": "fill",
            "height": 28,
            "fontSize": 16,
            "style": { "textColor": "$text" }
          },
          {
            "type": "label",
            "id": "repoLabel",
            "text": "仓库地址",
            "width": "fill",
            "height": 28,
            "fontSize": 16,
            "style": { "textColor": "$text" }
          },
          {
            "type": "label",
            "id": "repo",
            "text": "github.com/0use-TE/OusePocket",
            "width": "fill",
            "height": 44,
            "fontSize": 14,
            "style": { "textColor": "$accent" }
          },
          {
            "type": "label",
            "id": "author",
            "text": "作者：Ouse",
            "width": "fill",
            "height": 28,
            "fontSize": 14,
            "style": { "textColor": "$secondary" }
          }
        ]
      }
    ]
  }
}
