{
  "type": "viewScreen",
  "id": "settings_header",
  "commonProps": {
    "clickable": false,
    "scrollable": false
  },
  "style": {
    "padding": 0
  },
  "placement": {
    "mode": "absolute",
    "x": 0,
    "y": 0,
    "width": "${env.widthDp}",
    "height": "${constant.settings.layout.headerHeight}"
  },
  "children": [
    {
      "type": "container",
      "id": "bar",
      "commonProps": {
        "scrollable": false
      },
      "styleRefs": [
        "app.page"
      ],
      "style": {
        "paddingLeft": "12dp",
        "paddingRight": "12dp",
        "paddingTop": "4dp",
        "paddingBottom": "4dp"
      },
      "layout": {
        "type": "grid",
        "gridTemplateColumns": [
          "${constant.settings.layout.headerBackSize}",
          "match"
        ],
        "gridTemplateRows": [
          "match"
        ],
        "gap": "8dp",
        "crossAlign": "center"
      },
      "placement": {
        "mode": "absolute",
        "x": 0,
        "y": 0,
        "width": "match",
        "height": "${constant.settings.layout.headerHeight}"
      },
      "children": [
        {
          "type": "button",
          "id": "back",
          "commonProps": {
            "hidden": true
          },
          "bindings": {
            "commonProps.hidden": "commonProps.hidden"
          },
          "events": [
            {
              "type": "clicked",
              "action": "settings.header.back"
            }
          ],
          "interactionRefs": [
            "press.item"
          ],
          "styleRefs": [
            "app.listItem"
          ],
          "style": {
            "borderWidth": "0dp"
          },
          "layout": {
            "type": "flex",
            "mainAlign": "center",
            "crossAlign": "center"
          },
          "placement": {
            "mode": "flow",
            "gridColumn": 0,
            "gridRow": 0,
            "width": "${constant.settings.layout.headerBackSize}",
            "height": "${constant.settings.layout.headerBackSize}",
            "alignSelf": "center"
          },
          "children": [
            {
              "type": "image",
              "id": "icon",
              "commonProps": {
                "clickable": false
              },
              "imageProps": {
                "src": "${image.header.back}",
                "innerAlign": "contain"
              },
              "styleRefs": [
                "app.iconRecolor"
              ],
              "placement": {
                "mode": "flow",
                "width": "${constant.settings.layout.headerIconSize}",
                "height": "${constant.settings.layout.headerIconSize}"
              }
            }
          ]
        },
        {
          "type": "label",
          "id": "title",
          "bindings": {
            "labelProps.text": "labelProps.text"
          },
          "styleRefs": [
            "app.pageTitle"
          ],
          "style": {
            "fontSize": "18sp",
            "textAlign": "left"
          },
          "labelProps": {
            "text": ""
          },
          "placement": {
            "mode": "flow",
            "gridColumn": 1,
            "gridRow": 0,
            "width": "${expr(${env.widthDp} - ${constant.settings.layout.headerBackSize} - 32dp)}",
            "height": "wrap",
            "alignSelf": "center"
          }
        }
      ]
    }
  ]
}
