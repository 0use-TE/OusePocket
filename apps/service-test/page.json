      {"type": "button", "id": "refresh", "text": "查询服务与时间", "width": "fill", "height": 44},
      {"type": "label", "id": "clock", "text": "", "width": "fill", "height": "content", "fontSize": 14},
      {"type": "label", "id": "caps", "text": "", "width": "fill", "height": "content", "fontSize": 14},
