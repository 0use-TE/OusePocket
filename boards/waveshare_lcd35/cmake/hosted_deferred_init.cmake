# Hosted 2.12.3 starts transport/RPC tasks from a C constructor. Keep the
# dependency untouched and let the product start it after the desktop is ready.
if(NOT CONFIG_ESP_HOSTED_ENABLED)
    message(FATAL_ERROR "OusePocket deferred Hosted initialization requires ESP_HOSTED_ENABLED")
endif()

idf_build_get_property(ouse_hosted_components BUILD_COMPONENTS)
set(ouse_hosted_names "")
foreach(ouse_component IN LISTS ouse_hosted_components)
    if(ouse_component STREQUAL "esp_hosted" OR ouse_component STREQUAL "espressif__esp_hosted")
        list(APPEND ouse_hosted_names "${ouse_component}")
    endif()
endforeach()
list(LENGTH ouse_hosted_names ouse_hosted_name_count)
if(NOT ouse_hosted_name_count EQUAL 1)
    message(FATAL_ERROR "Expected exactly one esp_hosted component; review the Hosted startup overlay")
endif()
list(GET ouse_hosted_names 0 ouse_hosted_component)
idf_component_get_property(ouse_hosted_lib "${ouse_hosted_component}" COMPONENT_LIB)
idf_component_get_property(ouse_hosted_dir "${ouse_hosted_component}" COMPONENT_DIR)
get_target_property(ouse_hosted_sources "${ouse_hosted_lib}" SOURCES)

set(ouse_hosted_result "")
set(ouse_hosted_count 0)
foreach(ouse_source IN LISTS ouse_hosted_sources)
    if(NOT IS_ABSOLUTE "${ouse_source}")
        get_filename_component(ouse_source "${ouse_source}" ABSOLUTE BASE_DIR "${ouse_hosted_dir}")
    endif()
    get_filename_component(ouse_name "${ouse_source}" NAME)
    if(ouse_name STREQUAL "port_esp_hosted_host_init.c")
        math(EXPR ouse_hosted_count "${ouse_hosted_count} + 1")
        set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${ouse_source}")
        file(READ "${ouse_source}" ouse_hosted_text)
        string(REPLACE "\r\n" "\n" ouse_hosted_text "${ouse_hosted_text}")
        foreach(ouse_attribute IN ITEMS constructor destructor)
            string(REGEX MATCHALL "__attribute__[ \t\n]*\\(\\([ \t\n]*${ouse_attribute}[ \t\n]*\\)\\)"
                ouse_hosted_hooks "${ouse_hosted_text}")
            list(LENGTH ouse_hosted_hooks ouse_hosted_hook_count)
            if(NOT ouse_hosted_hook_count EQUAL 1)
                message(FATAL_ERROR "Expected one Hosted ${ouse_attribute}; review the Hosted startup overlay")
            endif()
        endforeach()
        # The reviewed file contains only the automatic init/deinit wrappers.
        # Fail on any new upstream behavior instead of silently removing it.
        string(SHA256 ouse_hosted_hash "${ouse_hosted_text}")
        if(NOT ouse_hosted_hash STREQUAL "232225d570d8c9546b11030d515f7e1b9aa92688d8493d0f6d0e1c54a9c8a618")
            message(FATAL_ERROR "Hosted automatic lifecycle source changed; review the Hosted startup overlay")
        endif()
        set(ouse_hosted_generated "${CMAKE_CURRENT_BINARY_DIR}/ouse_hosted/port_esp_hosted_host_init.c")
        file(CONFIGURE OUTPUT "${ouse_hosted_generated}" CONTENT
            "/* Product-owned replacement for Hosted's automatic lifecycle wrappers.\n * The product calls esp_hosted_init() after scheduler and desktop startup.\n * No constructor or destructor may start/stop transport implicitly.\n */\nconst unsigned ouse_hosted_manual_lifecycle = 1;\n" @ONLY)
        foreach(ouse_property IN ITEMS COMPILE_FLAGS COMPILE_OPTIONS COMPILE_DEFINITIONS INCLUDE_DIRECTORIES)
            get_source_file_property(ouse_value "${ouse_source}" TARGET_DIRECTORY "${ouse_hosted_lib}" "${ouse_property}")
            if(ouse_value AND NOT ouse_value STREQUAL "NOTFOUND")
                set_source_files_properties("${ouse_hosted_generated}" TARGET_DIRECTORY "${ouse_hosted_lib}"
                    PROPERTIES "${ouse_property}" "${ouse_value}")
            endif()
        endforeach()
        list(APPEND ouse_hosted_result "${ouse_hosted_generated}")
    else()
        # A second automatic hook needs an explicit review, even if the known
        # lifecycle file itself has not changed. This also covers IDF init hooks.
        if(ouse_source MATCHES "\\.(c|cpp|cc|cxx)$")
            set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${ouse_source}")
            file(READ "${ouse_source}" ouse_hosted_other)
            if(ouse_hosted_other MATCHES "__attribute__[ \t\r\n]*\\(\\([^)]*(constructor|destructor)"
                    OR ouse_hosted_other MATCHES "ESP_SYSTEM_INIT_FN[ \t\r\n]*\\(")
                message(FATAL_ERROR "Unexpected automatic Hosted startup hook in ${ouse_source}; review the Hosted startup overlay")
            endif()
        endif()
        list(APPEND ouse_hosted_result "${ouse_source}")
    endif()
endforeach()
if(NOT ouse_hosted_count EQUAL 1)
    message(FATAL_ERROR "Expected exactly one port_esp_hosted_host_init.c; review the Hosted startup overlay")
endif()

# Retain the existing target, dependencies, include paths and WHOLE_ARCHIVE.
set_property(TARGET "${ouse_hosted_lib}" PROPERTY SOURCES "${ouse_hosted_result}")
message(STATUS "OusePocket: Hosted transport initialization belongs to app_main; managed sources unchanged")
