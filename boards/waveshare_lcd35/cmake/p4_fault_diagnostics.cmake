# Generate product copies; never edit the ESP-IDF installation. Preserve object
# basenames: esp_system/linker.lf maps panic_arch and panic_handler to noflash.
if(NOT CONFIG_IDF_TARGET_ESP32P4 OR CONFIG_ESP32P4_REV_MIN_FULL LESS 300)
    message(FATAL_ERROR "Ouse fault diagnostics require the ESP32-P4 v3 CSR layout")
endif()
if(NOT CONFIG_ESP_PANIC_HANDLER_IRAM OR NOT CONFIG_ESP_COREDUMP_ENABLE_TO_UART
        OR NOT CONFIG_ESP_COREDUMP_CAPTURE_DRAM OR CONFIG_ESP_COREDUMP_STACK_SIZE LESS 2048)
    message(FATAL_ERROR "Enable IRAM panic and UART DRAM coredump in sdkconfig.defaults before configuring fault diagnostics")
endif()

function(ouse_fault_replace_once text_var original replacement)
    set(text "${${text_var}}")
    string(REPLACE "${original}" "" without "${text}")
    string(LENGTH "${text}" before_length)
    string(LENGTH "${without}" after_length)
    string(LENGTH "${original}" match_length)
    math(EXPR removed "${before_length} - ${after_length}")
    if(NOT removed EQUAL match_length)
        message(FATAL_ERROR "ESP-IDF panic source changed: expected one '${original}'; review Ouse diagnostic overlay")
    endif()
    string(REPLACE "${original}" "${replacement}" text "${text}")
    set(${text_var} "${text}" PARENT_SCOPE)
endfunction()

idf_component_get_property(ouse_panic_lib esp_system COMPONENT_LIB)
idf_component_get_property(ouse_panic_dir esp_system COMPONENT_DIR)
get_target_property(ouse_panic_sources ${ouse_panic_lib} SOURCES)
set(ouse_panic_result "")
set(ouse_panic_count 0)
foreach(ouse_source IN LISTS ouse_panic_sources)
    get_filename_component(ouse_name "${ouse_source}" NAME)
    if(ouse_name STREQUAL "panic_arch.c" OR ouse_name STREQUAL "panic_handler.c")
        if(NOT IS_ABSOLUTE "${ouse_source}")
            set(ouse_source "${ouse_panic_dir}/${ouse_source}")
        endif()
        set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${ouse_source}")
        file(READ "${ouse_source}" ouse_text)
        if(ouse_name STREQUAL "panic_handler.c")
            ouse_fault_replace_once(ouse_text "#include \"esp_private/panic_internal.h\""
                "#include \"esp_private/panic_internal.h\"\nvoid IRAM_ATTR ouse_fault_capture(const void *frame);")
            foreach(ouse_entry IN ITEMS panicHandler xt_unhandled_exception)
                ouse_fault_replace_once(ouse_text "void IRAM_ATTR ${ouse_entry}(void *frame)\n{"
                    "void IRAM_ATTR ${ouse_entry}(void *frame)\n{\n    ouse_fault_capture(frame);")
            endforeach()
        else()
            ouse_fault_replace_once(ouse_text "#define DIM(array) (sizeof(array)/sizeof(*array))"
                "#define DIM(array) (sizeof(array)/sizeof(*array))\n#include \"p4_fault_snapshot.inc\"")
            ouse_fault_replace_once(ouse_text "void panic_print_registers(const void *f, int core)\n{"
                "void panic_print_registers(const void *f, int core)\n{\n    ouse_fault_print(core);")
        endif()
        set(ouse_generated "${CMAKE_CURRENT_BINARY_DIR}/ouse_fault/${ouse_name}")
        file(CONFIGURE OUTPUT "${ouse_generated}" CONTENT "${ouse_text}" @ONLY)
        foreach(ouse_property IN ITEMS COMPILE_FLAGS COMPILE_OPTIONS COMPILE_DEFINITIONS INCLUDE_DIRECTORIES)
            get_source_file_property(ouse_value "${ouse_source}" TARGET_DIRECTORY ${ouse_panic_lib} ${ouse_property})
            if(ouse_value AND NOT ouse_value STREQUAL "NOTFOUND")
                set_source_files_properties("${ouse_generated}" TARGET_DIRECTORY ${ouse_panic_lib}
                    PROPERTIES ${ouse_property} "${ouse_value}")
            endif()
        endforeach()
        list(APPEND ouse_panic_result "${ouse_generated}")
        math(EXPR ouse_panic_count "${ouse_panic_count} + 1")
    else()
        list(APPEND ouse_panic_result "${ouse_source}")
    endif()
endforeach()
if(NOT ouse_panic_count EQUAL 2)
    message(FATAL_ERROR "Expected one ESP-IDF panic_handler.c and one RISC-V panic_arch.c")
endif()
set_property(TARGET ${ouse_panic_lib} PROPERTY SOURCES "${ouse_panic_result}")
target_include_directories(${ouse_panic_lib} PRIVATE "${CMAKE_CURRENT_LIST_DIR}/../diagnostics")

# A whole internal-DRAM dump at 115200 baud exceeds the panic RTC WDT's 10s.
# Feed only while a UART chunk progresses; a stalled writer can still reset.
idf_component_get_property(ouse_dump_lib espcoredump COMPONENT_LIB)
idf_component_get_property(ouse_dump_dir espcoredump COMPONENT_DIR)
get_target_property(ouse_dump_sources ${ouse_dump_lib} SOURCES)
set(ouse_dump_result "")
set(ouse_dump_count 0)
foreach(ouse_source IN LISTS ouse_dump_sources)
    get_filename_component(ouse_name "${ouse_source}" NAME)
    if(ouse_name STREQUAL "core_dump_uart.c" OR ouse_name STREQUAL "core_dump_elf.c")
        if(NOT IS_ABSOLUTE "${ouse_source}")
            set(ouse_source "${ouse_dump_dir}/${ouse_source}")
        endif()
        set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${ouse_source}")
        file(READ "${ouse_source}" ouse_text)
        if(ouse_name STREQUAL "core_dump_uart.c")
        ouse_fault_replace_once(ouse_text "#include \"esp_rom_sys.h\""
            "#include \"esp_rom_sys.h\"\n/* IDF declares this private helper locally in port/panic_handler.c, not in a header. */\nextern void esp_panic_handler_feed_wdts(void);")
        ouse_fault_replace_once(ouse_text "    while (addr < end) {"
            "    while (addr < end) {\n        esp_panic_handler_feed_wdts();")
        else()
            # IDF 6.1 walks all 8-bit heaps, including allocated PSRAM. Keep the
            # diagnosis bounded to internal memory; ELF sizing/writing use the
            # same function and capability mask in all three output stages.
            ouse_fault_replace_once(ouse_text
                "heap_caps_walk(MALLOC_CAP_8BIT, esp_core_dump_write_heap_blocks, &user_data);"
                "heap_caps_walk(MALLOC_CAP_INTERNAL | MALLOC_CAP_8BIT, esp_core_dump_write_heap_blocks, &user_data);")
        endif()
        set(ouse_generated "${CMAKE_CURRENT_BINARY_DIR}/ouse_fault/${ouse_name}")
        file(CONFIGURE OUTPUT "${ouse_generated}" CONTENT "${ouse_text}" @ONLY)
        foreach(ouse_property IN ITEMS COMPILE_FLAGS COMPILE_OPTIONS COMPILE_DEFINITIONS INCLUDE_DIRECTORIES)
            get_source_file_property(ouse_value "${ouse_source}" TARGET_DIRECTORY ${ouse_dump_lib} ${ouse_property})
            if(ouse_value AND NOT ouse_value STREQUAL "NOTFOUND")
                set_source_files_properties("${ouse_generated}" TARGET_DIRECTORY ${ouse_dump_lib}
                    PROPERTIES ${ouse_property} "${ouse_value}")
            endif()
        endforeach()
        list(APPEND ouse_dump_result "${ouse_generated}")
        math(EXPR ouse_dump_count "${ouse_dump_count} + 1")
    else()
        list(APPEND ouse_dump_result "${ouse_source}")
    endif()
endforeach()
if(NOT ouse_dump_count EQUAL 2)
    message(FATAL_ERROR "Expected exactly one ESP-IDF UART writer and one ELF core dump writer")
endif()
set_property(TARGET ${ouse_dump_lib} PROPERTY SOURCES "${ouse_dump_result}")
message(STATUS "OusePocket: retained early P4 fault v3 + bus snapshot + UART internal-only heap core dump; SDK sources unchanged")
