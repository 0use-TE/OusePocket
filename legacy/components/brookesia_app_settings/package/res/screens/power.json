{
  "type": "viewScreen",
  "id": "power",
  "mountMode": "dynamic",
  "styleRefs": [
    "app.page"
  ],
  "children": [
    {
      "type": "container",
      "id": "page",
      "placement": {
        "mode": "absolute",
        "x": "8dp",
        "y": "64dp",
        "width": "${expr(${env.widthDp} - 16dp)}",
        "height": "${expr(${env.heightDp} - 72dp)}"
      },
      "commonProps": {
        "scrollable": true
      },
      "layout": {
        "type": "flex",
        "flexFlow": "column",
        "gap": "8dp"
      },
      "children": [
        {
          "type": "label",
          "id": "status",
          "labelProps": {
            "text": "Battery: unknown"
          },
          "commonProps": {
            "clickable": false
          },
          "style": {
            "fontSize": "16sp"
          }
        },
        {
          "type": "button",
          "id": "refresh",
          "placement": {
            "width": "100%",
            "height": "40dp"
          },
          "style": {
            "padding": "8dp",
            "radius": "8dp",
            "borderWidth": "1dp",
            "borderColor": "#687080"
          },
          "layout": {
            "type": "flex",
            "mainAlign": "center",
            "crossAlign": "center"
          },
          "events": [
            {
              "type": "clicked",
              "action": "ouse.power.refresh"
            }
          ],
          "children": [
            {
              "type": "label",
              "id": "title",
              "labelProps": {
                "text": "Refresh"
              },
              "commonProps": {
                "clickable": false
              },
              "style": {
                "fontSize": "16sp"
              },
              "bindings": {
                "labelProps.text": "text"
              }
            }
          ]
        },
        {
          "type": "button",
          "id": "timeout0",
          "placement": {
            "width": "100%",
            "height": "40dp"
          },
          "style": {
            "padding": "8dp",
            "radius": "8dp",
            "borderWidth": "1dp",
            "borderColor": "#687080"
          },
          "layout": {
            "type": "flex",
            "mainAlign": "center",
            "crossAlign": "center"
          },
          "events": [
            {
              "type": "clicked",
              "action": "ouse.power.timeout0"
            }
          ],
          "children": [
            {
              "type": "label",
              "id": "title",
              "labelProps": {
                "text": "Keep screen on"
              },
              "commonProps": {
                "clickable": false
              },
              "style": {
                "fontSize": "16sp"
              },
              "bindings": {
                "labelProps.text": "text"
              }
            }
          ]
        },
        {
          "type": "button",
          "id": "timeout30",
          "placement": {
            "width": "100%",
            "height": "40dp"
          },
          "style": {
            "padding": "8dp",
            "radius": "8dp",
