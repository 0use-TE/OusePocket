# Keep the downloaded Brookesia sources intact. Use ESP-IDF's native pthread
# mutex implementation (its mutex semaphores live in internal RAM), and fully
# initialize the pthread creation config before Brookesia fills in its fields.
idf_component_get_property(pocket_pthread_lib brookesia_lib_utils COMPONENT_LIB)
idf_component_get_property(pocket_pthread_dir brookesia_lib_utils COMPONENT_DIR)
get_target_property(pocket_pthread_options ${pocket_pthread_lib} INTERFACE_LINK_OPTIONS)
foreach(pocket_wrap IN ITEMS "-Wl,--wrap=pthread_mutex_init" "-Wl,--wrap=pthread_mutex_destroy")
    if(NOT pocket_wrap IN_LIST pocket_pthread_options)
        message(FATAL_ERROR "Brookesia pthread wrapper changed; review native pthread policy")
    endif()
    list(REMOVE_ITEM pocket_pthread_options "${pocket_wrap}")
endforeach()
set_property(TARGET ${pocket_pthread_lib} PROPERTY INTERFACE_LINK_OPTIONS "${pocket_pthread_options}")

get_target_property(pocket_pthread_sources ${pocket_pthread_lib} SOURCES)
set(pocket_pthread_result "")
set(pocket_mutex_source_count 0)
set(pocket_config_source_count 0)
foreach(pocket_source IN LISTS pocket_pthread_sources)
    get_filename_component(pocket_name "${pocket_source}" NAME)
    if(pocket_name STREQUAL "thread_mutex.cpp")
        math(EXPR pocket_mutex_source_count "${pocket_mutex_source_count} + 1")
        continue()
    endif()
    if(pocket_name STREQUAL "thread_config.cpp")
        if(NOT IS_ABSOLUTE "${pocket_source}")
            set(pocket_source "${pocket_pthread_dir}/${pocket_source}")
        endif()
        set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${pocket_source}")
        file(READ "${pocket_source}" pocket_text)
        set(pocket_original "esp_pthread_cfg_t new_cfg;")
        string(REGEX MATCHALL "esp_pthread_cfg_t new_cfg" pocket_matches "${pocket_text}")
        list(LENGTH pocket_matches pocket_match_count)
        if(NOT pocket_match_count EQUAL 1)
            message(FATAL_ERROR "Brookesia pthread config changed; review initialization overlay")
        endif()
        string(REPLACE "${pocket_original}"
            "auto new_cfg = esp_pthread_get_default_config();\n    new_cfg.inherit_cfg = false;"
            pocket_text "${pocket_text}")
        set(pocket_generated "${CMAKE_CURRENT_BINARY_DIR}/pocket_thread_config.cpp")
        file(CONFIGURE OUTPUT "${pocket_generated}" CONTENT "${pocket_text}" @ONLY)
        get_source_file_property(pocket_flags "${pocket_source}" COMPILE_FLAGS)
        if(pocket_flags)
            set_source_files_properties("${pocket_generated}" PROPERTIES COMPILE_FLAGS "${pocket_flags}")
        endif()
        list(APPEND pocket_pthread_result "${pocket_generated}")
        math(EXPR pocket_config_source_count "${pocket_config_source_count} + 1")
    else()
        list(APPEND pocket_pthread_result "${pocket_source}")
    endif()
endforeach()
if(NOT pocket_mutex_source_count EQUAL 1 OR NOT pocket_config_source_count EQUAL 1)
    message(FATAL_ERROR "Expected one Brookesia mutex wrapper and one thread config source")
endif()
set_property(TARGET ${pocket_pthread_lib} PROPERTY SOURCES "${pocket_pthread_result}")
message(STATUS "OusePocket: native ESP-IDF pthread mutexes and initialized thread config")
