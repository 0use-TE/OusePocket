{
  "api": 1,
  "units": "dp",
  "root": {
    "type": "container",
    "id": "page",
    "width": "fill",
    "height": "fill",
    "padding": 12,
    "style": { "backgroundColor": "$background" },
    "children": [
      {
        "type": "label",
        "id": "title",
        "text": "网易云",
        "x": 0,
        "y": 0,
        "width": 160,
        "height": 32,
        "fontSize": 20,
        "style": { "textColor": "$text" }
      },
      {
        "type": "label",
        "id": "status",
        "text": "连接中",
        "x": 184,
        "y": 0,
        "width": 112,
        "height": 32,
        "fontSize": 15,
        "style": { "textColor": "$secondary", "textAlign": "right" }
      },
      {
        "type": "image",
        "id": "disc",
        "src": "disc0",
        "x": 86,
        "y": 48,
        "width": 128,
        "height": 128
      },
      {
        "type": "label",
        "id": "now",
        "text": "等待播放",
        "x": 0,
        "y": 188,
        "width": 296,
        "height": 24,
        "fontSize": 14,
        "style": { "textColor": "$secondary", "textAlign": "center" }
      },
      {
        "type": "container",
        "id": "transport",
        "x": 0,
        "y": 276,
        "width": 296,
        "height": 56,
        "layout": "row",
        "gap": 10,
        "children": [
          {
            "type": "button",
            "id": "previous",
            "text": "上一首",
            "width": "fill",
            "height": 56,
            "fontSize": 15,
            "style": { "backgroundColor": "$surface", "textColor": "$text", "borderColor": "$border", "borderWidth": 1, "radius": 16 }
          },
          {
            "type": "button",
            "id": "toggle",
            "text": "暂停",
            "width": "fill",
            "height": 56,
            "fontSize": 16,
            "style": { "backgroundColor": "$accent", "textColor": "#ffffff", "radius": 16 }
          },
          {
            "type": "button",
            "id": "next",
            "text": "下一首",
            "width": "fill",
            "height": 56,
            "fontSize": 15,
            "style": { "backgroundColor": "$surface", "textColor": "$text", "borderColor": "$border", "borderWidth": 1, "radius": 16 }
          }
        ]
      },
      {
        "type": "container",
        "id": "volume",
        "x": 0,
        "y": 344,
        "width": 296,
        "height": 48,
        "layout": "row",
        "gap": 10,
        "children": [
          {
            "type": "button",
            "id": "quieter",
            "text": "音量-",
            "width": "fill",
            "height": 48,
            "fontSize": 15,
            "style": { "backgroundColor": "$surface", "textColor": "$text", "borderColor": "$border", "borderWidth": 1, "radius": 14 }
          },
          {
            "type": "button",
            "id": "mute",
            "text": "静音",
            "width": "fill",
            "height": 48,
            "fontSize": 15,
            "style": { "backgroundColor": "$surface", "textColor": "$text", "borderColor": "$border", "borderWidth": 1, "radius": 14 }
          },
          {
            "type": "button",
            "id": "louder",
            "text": "音量+",
            "width": "fill",
            "height": 48,
            "fontSize": 15,
            "style": { "backgroundColor": "$surface", "textColor": "$text", "borderColor": "$border", "borderWidth": 1, "radius": 14 }
          }
        ]
      }
    ]
  }
}
